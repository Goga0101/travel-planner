# Copy to .env and fill in. NEVER commit .env. Placeholders only.
# .NET reads nested settings from environment variables using "__" as separator.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=travel_planner
POSTGRES_USER=travel_planner
POSTGRES_PASSWORD=<choose-a-local-password>
POSTGRES_PORT=5433

# --- Data mode: Demo (labelled sample data) or Live (configured real providers only) ---
Providers__Mode=Demo

# --- Flights: Amadeus Enterprise (Self-Service was shut down on 2026-07-17) ---
Providers__Amadeus__Enabled=false
Providers__Amadeus__BaseUrl=<enterprise-base-url>
Providers__Amadeus__ClientId=<amadeus-client-id>
Providers__Amadeus__ClientSecret=<amadeus-client-secret>

# --- Flights: Travelpayouts / Aviasales Data API (cached prices + affiliate links) ---
Providers__Travelpayouts__Enabled=false
Providers__Travelpayouts__ApiToken=<travelpayouts-api-token>
Providers__Travelpayouts__Marker=<travelpayouts-affiliate-marker>

# --- Accommodation: Booking.com Demand API (Managed Affiliate Partner approval required) ---
Providers__BookingCom__Enabled=false
Providers__BookingCom__BaseUrl=https://demandapi-sandbox.booking.com/3.1
Providers__BookingCom__ApiKey=<booking-demand-api-key>
Providers__BookingCom__AffiliateId=<booking-affiliate-id>

# --- Accommodation search links (no API needed). Affiliate tracking is optional:
#     either Booking.com "aid", or a CJ/Awin deep-link template with {url} (add its host to OutboundLinks__AllowedHosts__N).
Providers__BookingComLinks__Enabled=true
Providers__BookingComLinks__AffiliateId=<booking-affiliate-aid>
Providers__BookingComLinks__DeepLinkTemplate=<network-deeplink-with-{url}>

# --- Transfers: Google Maps Platform Routes API (server key, restricted to Routes API) ---
Providers__GoogleRoutes__Enabled=false
Providers__GoogleRoutes__ApiKey=<google-routes-server-key>

# --- Optional: Maps Embed API browser key (HTTP-referrer restricted) for the route map ---
ClientConfig__MapsEmbedApiKey=<google-maps-embed-browser-key>

# --- Optional budget estimates (leave empty to disable) ---
Budget__EstimatesCurrency=
Budget__DailyFoodPerPerson=
Budget__DailyLocalTransportPerPerson=
Budget__ContingencyPercent=0

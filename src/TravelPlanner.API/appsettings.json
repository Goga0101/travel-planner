{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TravelPlanner": "Host=localhost;Port=5433;Database=travel_planner;Username=travel_planner;Password=<set via env or user-secrets>"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "UseHttpsRedirection": false,
  "Swagger": { "Enabled": false },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://goga0101.github.io" ]
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "SearchesPerMinute": 10,
    "RefreshesPerMinute": 20
  },
  "Catalog": {
    "Path": "catalog/destinations.json",
    "SeedOnStartup": true,
    "NearbyPath": "catalog/nearby.json"
  },
  "Jobs": {
    "MaxConcurrentSearches": 2
  },
  "Planning": {
    "MaxDateCombinations": 7,
    "MaxAutoDestinations": 12,
    "MaxFlightSearches": 40,
    "MaxCombosPerDestinationForAccommodation": 2,
    "MaxFlightOffersPerSearch": 10,
    "MaxFlightsPerCandidate": 1,
    "MaxAccommodationsPerCandidate": 3,
    "MaxAccommodationResults": 20,
    "MaxConcurrentProviderCalls": 4,
    "ProviderCallTimeoutSeconds": 25,
    "MaxResults": 5,
    "MaxPlansPerDestination": 2,
    "MaxOverBudgetFallbackPlans": 3,
    "Ranking": {
      "Cost": 0.40,
      "Flight": 0.25,
      "Accommodation": 0.15,
      "Transfer": 0.10,
      "BudgetRemaining": 0.10,
      "IncompletePenalty": 0.85
    }
  },
  "Budget": {
    "EstimatesCurrency": null,
    "DailyFoodPerPerson": null,
    "DailyLocalTransportPerPerson": null,
    "ContingencyPercent": 0
  },
  "ExchangeRates": {
    "Enabled": true,
    "EcbDailyUrl": "https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml",
    "CacheHours": 6
  },
  "OutboundLinks": {
    "AllowedHosts": [
      "booking.com", "aviasales.com", "google.com", "uber.com",
      "aena.es", "parisaeroport.fr", "heathrow.com", "adr.it", "schiphol.nl", "prg.aero", "viennaairport.com", "bud.hu",
      "berlin-airport.de", "ana.pt", "aia.gr", "seamilano.eu", "munich-airport.de", "lotnisko-chopina.pl", "krakowairport.pl",
      "istairport.com", "cph.dk", "veniceairport.it", "hermesairports.com", "tbilisiairport.com",
      "tmb.cat", "ratp.fr", "tfl.gov.uk", "atac.roma.it", "gvb.nl", "pid.cz", "wienerlinien.at", "bkk.hu", "bvg.de", "carris.pt",
      "oasa.gr", "atm.it", "crtm.es", "mvv-muenchen.de", "wtp.waw.pl", "mpk.krakow.pl", "metro.istanbul", "dinoffentligetransport.dk",
      "actv.avmspa.it"
    ]
  },
  "ClientConfig": {
    "MapsEmbedApiKey": ""
  },
  "Providers": {
    "Mode": "Demo",
    "FlightCacheMinutes": 10,
    "AccommodationCacheMinutes": 10,
    "TransportCacheMinutes": 60,
    "Http": {
      "AttemptTimeoutSeconds": 10,
      "TotalTimeoutSeconds": 25,
      "MaxRetryAttempts": 2
    },
    "Amadeus": {
      "Enabled": false,
      "BaseUrl": "https://api.amadeus.com",
      "ClientId": "",
      "ClientSecret": "",
      "OfferValidityMinutes": 30
    },
    "Travelpayouts": {
      "Enabled": false,
      "BaseUrl": "https://api.travelpayouts.com",
      "ApiToken": "",
      "Marker": "",
      "LinkBaseUrl": "https://www.aviasales.com"
    },
    "BookingComLinks": {
      "Enabled": true,
      "SearchUrl": "https://www.booking.com/searchresults.html",
      "AffiliateId": "",
      "DeepLinkTemplate": ""
    },
    "BookingCom": {
      "Enabled": false,
      "BaseUrl": "https://demandapi.booking.com/3.1",
      "ApiKey": "",
      "AffiliateId": "",
      "BookerCountry": "ge",
      "OfferValidityMinutes": 30
    },
    "Geoapify": {
      "Enabled": true,
      "BaseUrl": "https://api.geoapify.com",
      "ApiKey": "",
      "CacheHours": 24
    },
    "GoogleRoutes": {
      "Enabled": false,
      "BaseUrl": "https://routes.googleapis.com",
      "ApiKey": ""
    }
  }
}
